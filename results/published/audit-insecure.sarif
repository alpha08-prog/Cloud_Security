          "partialFingerprints": {
            "isolabTarget/v1": "insecure:HV-03:host:host"
          },
          "properties": {
            "axis": "hypervisor-vulnerabilities",
            "tenant": null,
            "severity": "high"
          },
          "suppressions": [
            {
              "kind": "external",
              "status": "accepted",
              "justification": "The WSL2 kernel reports spec_rstack_overflow as \"Vulnerable: Safe RET, no microcode\". The SRSO microcode fix is delivered through the physical host's firmware/Windows updates; the container host (a WSL2 VM) cannot load microcode itself. This is a provider-layer weakness outside the testbed's control - the paper's point about tenants depending on a hypervisor they cannot inspect or fix. (expires 2026-12-31, approved by project owner (pending review))"
            }
          ]
        },
