{
  "$id": "isolab/detection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detectedAtNs": {
      "description": "When the auditor raised the detection (same clock)",
      "title": "Detectedatns",
      "type": "integer"
    },
    "eventTimeNs": {
      "description": "When the action happened (engine or canary clock, inside the VM)",
      "title": "Eventtimens",
      "type": "integer"
    },
    "evidence": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Evidence",
      "type": "object"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "latencyMs": {
      "title": "Latencyms",
      "type": "number"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "requirements": {
      "items": {
        "enum": [
          "R1",
          "R2",
          "R3",
          "R4"
        ],
        "type": "string"
      },
      "title": "Requirements",
      "type": "array"
    },
    "rule": {
      "enum": [
        "DET-01",
        "DET-02",
        "DET-03",
        "DET-04",
        "DET-05",
        "DET-06",
        "DET-07",
        "DET-08",
        "DET-09"
      ],
      "title": "Rule",
      "type": "string"
    },
    "service": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Service"
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "title": "Severity",
      "type": "string"
    },
    "tenant": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tenant"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "workloadId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Workloadid"
    }
  },
  "required": [
    "id",
    "rule",
    "title",
    "severity",
    "requirements",
    "tenant",
    "workloadId",
    "service",
    "eventTimeNs",
    "detectedAtNs",
    "latencyMs",
    "message"
  ],
  "title": "Detection",
  "type": "object"
}
